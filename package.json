{
  "name": "cline-console",
  "version": "0.13.0",
  "description": "Local terminal control plane for the Cline VS Code extension",
  "publisher": "bvrznski",
  "displayName": "Cline Console",
  "author": "bvrznski",
  "categories": [
    "Other"
  ],
  "keywords": [
    "cline",
    "cli",
    "automation",
    "task-queue",
    "local-ipc"
  ],
  "license": "MIT",
  "preview": true,
  "homepage": "https://github.com/bvrznski/cline-console#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvrznski/cline-console.git"
  },
  "bugs": {
    "url": "https://github.com/bvrznski/cline-console/issues"
  },
  "main": "./dist/src/extension/extension.js",
  "bin": {
    "cline-console": "dist/src/client/cli.js"
  },
  "man": [
    "man/cline-console.1"
  ],
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.5"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cline-console.startServer"
  ],
  "extensionDependencies": [
    "saoudrizwan.claude-dev"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cline-console.startServer",
        "title": "Cline Console: Start Server"
      },
      {
        "command": "cline-console.stopServer",
        "title": "Cline Console: Stop Server"
      },
      {
        "command": "cline-console.showStatus",
        "title": "Cline Console: Show Status"
      },
      {
        "command": "cline-console.testClineIntegration",
        "title": "Cline Console: Test Cline Integration"
      },
      {
        "command": "cline-console.copySocketPath",
        "title": "Cline Console: Copy Socket Path"
      }
    ],
    "configuration": {
      "title": "Cline Console",
      "properties": {
        "cline-console.enabled": {
          "type": "boolean",
          "default": true
        },
        "cline-console.autoStart": {
          "type": "boolean",
          "default": true
        },
        "cline-console.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "debug"
          ],
          "default": "info"
        },
        "cline-console.socketDirectory": {
          "type": "string",
          "default": ""
        },
        "cline-console.taskScanner.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Enable completion scanning and same-task continuation policies for all workspaces."
        },
        "cline-console.taskScanner.terminalStabilitySeconds": {
          "type": "number",
          "minimum": 0,
          "default": 15,
          "scope": "application",
          "description": "Seconds a Cline completion must remain terminal before the scanner evaluates it."
        },
        "cline-console.taskScanner.interTaskDelaySeconds": {
          "type": "number",
          "minimum": 0,
          "default": 15,
          "scope": "application",
          "description": "Seconds to wait after a completed queue task before dispatching the next task."
        },
        "cline-console.taskScanner.detectIncompleteCompletions": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Keep a task active when its completion report or task progress declares unfinished work."
        },
        "cline-console.taskScanner.detectTestTimeouts": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Keep a task active when a recognized test command timed out without a successful same-scope rerun."
        },
        "cline-console.taskScanner.implementAuditRecommendations": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "For audit tasks, request implementation of concrete recommendations in the same task before completion."
        },
        "cline-console.taskScanner.requirePostImplementationReport": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Require audit remediation to produce a durable post-remediation report with validation and residual risk."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package",
    "verify:release": "npm test && npm audit && npm pack --dry-run && vsce ls --tree"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
